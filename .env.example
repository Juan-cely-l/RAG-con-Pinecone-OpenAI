# Copy this file to .env and fill in the values. Never commit real keys.

# --- Pinecone (required) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mma-rag-demo

# Optional Pinecone serverless settings (used only when ingest.py creates the index)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional namespace inside the index (empty = default namespace).
# Useful to keep experiments separate, e.g. one namespace per chunk size.
PINECONE_NAMESPACE=

# --- Google Gemini (required) ---
GOOGLE_API_KEY=your_google_api_key_here

# Optional Gemini model names
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Optional RAG tuning (defaults shown) ---
# Sampling temperature for the chat model (low = more faithful to the context)
RAG_TEMPERATURE=0.2
# Chunking used by ingest.py (characters). Re-run `python ingest.py --reset` after changing.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Number of chunks retrieved per question
RAG_TOP_K=4
# Minimum cosine similarity of the best chunk; below it the system abstains without calling the LLM
RAG_SCORE_THRESHOLD=0.5
# Maximum question length (characters, after whitespace normalization)
RAG_MAX_QUESTION_CHARS=500
# Maximum total characters of retrieved context sent to the LLM
RAG_MAX_CONTEXT_CHARS=6000

# --- Optional resilience settings ---
# Extra attempts on 429/5xx/timeouts, with exponential backoff: base * 2^attempt seconds
RAG_MAX_RETRIES=4
RAG_RETRY_BASE_DELAY=2.0
# Per-request timeout for Gemini chat calls (seconds)
RAG_REQUEST_TIMEOUT=60
