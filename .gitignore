# =============================================================================
# .gitignore — MMA RAG (LangChain + Pinecone + Gemini)
# =============================================================================

# --- Secrets & local configuration (NEVER commit) ----------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json
.envrc

# --- Python bytecode / caches -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments -----------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Packaging / build artifacts ----------------------------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Testing / coverage / type checking / linting -----------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# --- Evaluation: keep final results, ignore temporary/partial runs ------------
# eval/results/results.json and eval/results/REPORT.md ARE versioned (evidence).
eval/results/*.partial.json
eval/results/tmp/

# --- Logs ---------------------------------------------------------------------
*.log
logs/

# --- Notebooks ----------------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / IDEs -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- AI assistant local settings ----------------------------------------------
.claude/settings.local.json
.cursorignore
.cursorindexingignore

# --- OS files -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
